# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.

# The Outlook mailbox under test (the receiver).
TEST_RECEIVER=tester@yourcompany.com

# Brevo SMTP relay (Brevo: SMTP & API, SMTP tab).
# SMTP_USER is the SMTP login shown there (it looks like xxxxxxx@smtp-brevo.com, it is NOT your account email).
# SMTP_PASS is an SMTP key created on that page (NOT your account password and NOT the v3 API key).
SMTP_USER=xxxxxxx@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
# The From address of the test emails. It must be a sender or domain verified in Brevo
# (Senders, Domains and Dedicated IPs); Brevo rejects other addresses.
# Do NOT use a no-reply style address here: the agent drops mail from no-reply senders as noise,
# so the asks you seed would never show up. Use a normal-looking address.
SMTP_FROM=tester@your-verified-domain.com
# Only if you cannot get a normal-looking sender: send anyway (the agent drops mail from a no-reply sender as noise,
# so asks seeded this way will not show up on the board).
# ALLOW_NO_REPLY=true

# Optional relay settings. Defaults: smtp-relay.brevo.com, port 587 (STARTTLS).
# Port 465 means an implicit TLS connection unless SMTP_SECURE=false.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional: a different sender address per persona so senders look different (each verified in Brevo).
# Personas: alice, bob, carol, dana, system, newsletter, vendor. Unlisted personas use SMTP_FROM.
# A persona shares SMTP_USER and SMTP_PASS unless it gives its own "user" and "pass".
# SMTP_ACCOUNTS={"alice":{"from":"alice@your-verified-domain.com"},"dana":{"from":"dana@your-verified-domain.com"}}
# The automated personas (system, newsletter) are meant to look automated, so give them a no-reply sender:
# SMTP_ACCOUNTS={"system":{"from":"no-reply@your-verified-domain.com"},"newsletter":{"from":"no-reply@your-verified-domain.com"}}

# Recommended safety guard: only these recipient domains are allowed for TEST_RECEIVER and OTHER_RECIPIENT.
# ALLOWED_RECIPIENT_DOMAINS=yourcompany.com

# Optional: address used for the "other recipient" in Cc-only and multi-recipient scenarios.
# Defaults to SMTP_FROM.
# OTHER_RECIPIENT=teammate@yourcompany.com
