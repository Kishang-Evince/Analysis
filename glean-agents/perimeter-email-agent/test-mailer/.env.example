# Copy to .env and fill in. .env is git-ignored. Never commit real credentials.

# The Outlook mailbox under test (the receiver).
TEST_RECEIVER=tester@yourcompany.com

# Default Gmail sender. Use a Google App Password (Google Account > Security > 2-Step Verification > App passwords),
# NOT the normal account password.
GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: a separate Gmail account per persona so senders look different.
# Personas: alice, bob, carol, dana, system, newsletter, vendor. Unlisted personas use the default sender.
# GMAIL_ACCOUNTS={"alice":{"user":"alice.test@gmail.com","pass":"app password"},"dana":{"user":"dana.test@gmail.com","pass":"app password"}}

# Recommended safety guard: only these recipient domains are allowed for TEST_RECEIVER and OTHER_RECIPIENT.
# ALLOWED_RECIPIENT_DOMAINS=yourcompany.com

# Optional: address used for the "other recipient" in Cc-only and multi-recipient scenarios.
# Defaults to the sending Gmail address itself.
# OTHER_RECIPIENT=teammate@yourcompany.com
