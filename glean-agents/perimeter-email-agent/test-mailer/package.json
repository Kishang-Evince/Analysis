{
  "name": "test-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "Seeds a test mailbox by sending scripted emails from Gmail.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "list": "node send-test-emails.mjs --list",
    "send": "node --env-file-if-exists=.env send-test-emails.mjs",
    "dry-run": "node --env-file-if-exists=.env send-test-emails.mjs --dry-run",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80",
    "seed:a1": "node --env-file-if-exists=.env send-test-emails.mjs --group A1 --yes",
    "seed:a2": "node --env-file-if-exists=.env send-test-emails.mjs --group A2 --yes",
    "seed:a3": "node --env-file-if-exists=.env send-test-emails.mjs --group A3 --yes",
    "seed:a4": "node --env-file-if-exists=.env send-test-emails.mjs --group A4 --yes",
    "seed:a5": "node --env-file-if-exists=.env send-test-emails.mjs --group A5 --yes",
    "seed:a7": "node --env-file-if-exists=.env send-test-emails.mjs --group A7 --yes",
    "seed:a8": "node --env-file-if-exists=.env send-test-emails.mjs --group A8 --yes",
    "seed:a9": "node --env-file-if-exists=.env send-test-emails.mjs --group A9 --yes",
    "seed:email-01": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-01 --yes",
    "seed:e13": "node --env-file-if-exists=.env send-test-emails.mjs --group E13 --yes",
    "seed:e11": "node --env-file-if-exists=.env send-test-emails.mjs --group E11 --yes",
    "seed:e05": "node --env-file-if-exists=.env send-test-emails.mjs --group E05 --yes",
    "seed:e06": "node --env-file-if-exists=.env send-test-emails.mjs --group E06 --yes",
    "seed:e17": "node --env-file-if-exists=.env send-test-emails.mjs --group E17 --yes",
    "seed:e19": "node --env-file-if-exists=.env send-test-emails.mjs --group E19 --yes",
    "seed:e20": "node --env-file-if-exists=.env send-test-emails.mjs --group E20 --yes",
    "seed:e13-bulk80": "node --env-file-if-exists=.env send-test-emails.mjs --scenario E13-07 --delay 500 --yes",
    "seed:e13-bulk-topup": "node --env-file-if-exists=.env send-test-emails.mjs --scenario E13-08 --delay 500 --limit 220 --yes",
    "seed:email-02": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-02 --yes",
    "seed:email-03": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-03 --yes",
    "seed:email-04": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-04 --yes",
    "seed:email-05": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-05 --yes",
    "seed:email-06": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-06 --yes",
    "seed:email-07": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-07 --yes",
    "seed:email-09": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-09 --yes",
    "seed:email-10": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-10 --yes",
    "seed:email-11": "node --env-file-if-exists=.env send-test-emails.mjs --ticket EMAIL-11 --yes",
    "seed:c": "node --env-file-if-exists=.env send-test-emails.mjs --group C --yes",
    "check:0": "node check-spec.mjs 0",
    "check:1": "node check-spec.mjs 1",
    "check:2": "node check-spec.mjs 2",
    "check:3": "node check-spec.mjs 3",
    "check:4": "node check-spec.mjs 4",
    "check:5": "node check-spec.mjs 5",
    "check:6": "node check-spec.mjs 6",
    "check:7": "node check-spec.mjs 7",
    "check:8": "node check-spec.mjs 8",
    "check:9": "node check-spec.mjs 9",
    "check:10": "node check-spec.mjs 10"
  },
  "dependencies": {
    "nodemailer": "^10.1.0"
  }
}
