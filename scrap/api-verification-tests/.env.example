# Glean API Credentials
# Copy this file to .env and fill in your actual values - never commit real values here.

GLEAN_API_TOKEN=your_client_or_platform_api_token_here
GLEAN_SERVER_URL=https://your-instance-be.glean.com
GLEAN_INSTANCE=your-instance-name
GLEAN_INDEXING_TOKEN=your_indexing_api_token_here
GLEAN_ACT_AS=optional_user_email_for_x_glean_actas
GLEAN_DATASOURCE=your_registered_datasource_name
GLEAN_TEST_DOC_ID=test-doc
GLEAN_TEST_OBJECT_TYPE=Document
